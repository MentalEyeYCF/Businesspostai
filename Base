    <script>
        // Complete JavaScript for autonomous functionality
        class BusinessPostAI {
            constructor() {
                this.maxFreeUses = 5;
                this.usageKey = 'bp_usage_data';
                this.revenueKey = 'bp_revenue_data';
                this.premiumKey = 'bp_premium_status';
                this.templates = {
                    promotion: [
                        "🌟 FLASH SALE ALERT! 🌟\n\nGet {offer} at {business} today only! Don't miss out on this incredible deal that will transform your {industry} experience.\n\n📍 {location}\n⏰ Limited time offer\n👉 Tap the link in bio to claim yours!",
                        
                        "🔥 HOT DEAL JUST FOR YOU! 🔥\n\n{business} is offering {offer} to our amazing social media followers! This exclusive deal won't last long, so act fast!\n\n✅ No hidden fees\n✅ Easy redemption\n✅ Limited quantities available\n\nComment 'DEAL' below and we'll send you the link!",
                        
                        "🎉 SPECIAL ANNOUNCEMENT! 🎉\n\nWe're celebrating {milestone} at {business} with an amazing offer just for you! Enjoy {offer} when you {action}.\n\nThis is our way of saying thank you to our incredible community. Share this post with a friend who would love this deal!\n\n#smallbusiness #{businessType}"
                    ],
                    quote: [
                        "\"Success is not final, failure is not fatal: it is the courage to continue that counts.\"\n\n- Winston Churchill\n\nWhat does success mean to you? Share your thoughts below! 👇\n\n{business} - Building {businessType} one day at a time.",
                        
                        "\"The best way to predict the future is to create it.\"\n\n- Abraham Lincoln\n\nAt {business}, we're not just dreaming about the future - we're building it every single day through {businessType}.\n\nWhat future are you creating today?",
                        
                        "\"Your time is limited, don't waste it living someone else's life.\"\n\n- Steve Jobs\n\nAt {business}, we believe in empowering {targetAudience} to live authentically and pursue their passions through {businessType}.\n\nWhat passion are you pursuing today?"
                    ],
                    announcement: [
                        "🚀 EXCITING NEWS! 🚀\n\n{business} is thrilled to announce {announcement}! After months of hard work and dedication, we're ready to serve you even better.\n\n✨ What this means for you:\n• {benefit1}\n• {benefit2}\n• {benefit3}\n\nJoin us in celebrating this milestone! Share your excitement in the comments below! 👇",
                        
                        "🌟 BIG ANNOUNCEMENT! 🌟\n\nWe've been working behind the scenes on something special, and we can't wait to share it with you! {business} is now offering {newService} to all our valued customers.\n\n📅 Launch Date: {date}\n📍 Location: {location}\n🎯 Perfect for: {targetAudience}\n\nEarly bird special: {offer} for the first 50 customers!\n\n#newbeginnings #{businessType}",
                        
                        "🎉 WE DID IT! 🎉\n\nThanks to your incredible support, {business} has reached {milestone}! To celebrate this amazing achievement, we're giving back to our community with {specialOffer}.\n\nNone of this would be possible without you. Thank you for being part of our journey!\n\nShare this post to spread the celebration! ❤️"
                    ]
                };
                
                this.initialize();
            }
            
            initialize() {
                this.loadUsageData();
                this.loadRevenueData();
                this.setupEventListeners();
                this.showRevenueTracker();
                this.checkDailyReset();
            }
            
            loadUsageData() {
                let usageData = localStorage.getItem(this.usageKey);
                if (!usageData) {
                    usageData = {
                        uses: 0,
                        lastReset: new Date().toISOString().split('T')[0],
                        premium: localStorage.getItem(this.premiumKey) === 'true'
                    };
                    localStorage.setItem(this.usageKey, JSON.stringify(usageData));
                }
                this.usageData = JSON.parse(usageData);
                this.updateUsageDisplay();
            }
            
            loadRevenueData() {
                let revenueData = localStorage.getItem(this.revenueKey);
                if (!revenueData) {
                    revenueData = {
                        daily: {},
                        total: 0,
                        events: [],
                        lastUpdated: new Date().toISOString()
                    };
                    localStorage.setItem(this.revenueKey, JSON.stringify(revenueData));
                }
                this.revenueData = JSON.parse(revenueData);
                this.updateRevenueDisplay();
            }
            
            setupEventListeners() {
                // Generate button
                document.getElementById('generateBtn').addEventListener('click', () => this.generateContent());
                
                // Copy button
                document.getElementById('copyBtn').addEventListener('click', () => this.copyContent());
                
                // Platform buttons
                document.querySelectorAll('.platform-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        document.querySelectorAll('.platform-btn').forEach(b => b.classList.remove('active'));
                        e.target.classList.add('active');
                    });
                });
                
                // Template cards
                document.querySelectorAll('.template-card').forEach(card => {
                    card.addEventListener('click', () => {
                        const template = card.dataset.template;
                        this.showTemplatePreview(template);
                    });
                });
                
                // Premium upgrade buttons
                document.querySelectorAll('.premium-upgrade').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const plan = e.target.dataset.plan || e.target.closest('button').dataset.plan;
                        this.showPremiumUpgrade(plan);
                    });
                });
                
                // Affiliate links
                document.querySelectorAll('.affiliate-link').forEach(link => {
                    link.addEventListener('click', (e) => {
                        const product = link.dataset.product;
                        this.trackRevenueEvent('affiliate_click', 0.25, { product });
                    });
                });
                
                // Marketing form
                document.getElementById('marketingForm').addEventListener('submit', (e) => {
                    e.preventDefault();
                    this.submitLeadForm();
                });
                
                // Save and share buttons
                document.getElementById('saveBtn').addEventListener('click', () => {
                    this.saveContent();
                });
                
                document.getElementById('shareBtn').addEventListener('click', () => {
                    this.shareContent();
                });
            }
            
            generateContent() {
                if (!this.checkUsageLimits()) return;
                
                const postType = document.getElementById('postType').value;
                const businessType = document.getElementById('businessType').value || 'local business';
                const keyMessage = document.getElementById('keyMessage').value || 'amazing products and services';
                const platform = document.querySelector('.platform-btn.active').dataset.platform;
                
                if (!businessType) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Business Type Required',
                        text: 'Please enter your business type or industry'
                    });
                    return;
                }
                
                // Generate content based on template
                let content = '';
                switch(postType) {
                    case 'promotion':
                        content = this.generatePromotionContent(businessType, keyMessage, platform);
                        break;
                    case 'quote':
                        content = this.generateQuoteContent(businessType, platform);
                        break;
                    case 'announcement':
                        content = this.generateAnnouncementContent(businessType, keyMessage, platform);
                        break;
                    default:
                        content = this.generateDefaultContent(businessType, keyMessage, platform);
                }
                
                // Display result
                document.getElementById('generatedContent').innerHTML = `
                    <div class="alert alert-primary">
                        <h5 class="mb-3"><i class="fas fa-star me-2"></i>AI-Generated ${this.capitalizeFirstLetter(postType)} Post</h5>
                        <p class="fs-5 mb-0">${content.replace(/\n/g, '<br>')}</p>
                    </div>
                    <div class="mt-3">
                        <span class="badge bg-info me-2">Platform: ${this.capitalizeFirstLetter(platform)}</span>
                        <span class="badge bg-success">AI-Generated</span>
                    </div>
                `;
                
                document.getElementById('resultSection').style.display = 'block';
                
                // Track revenue event
                this.trackRevenueEvent('content_generation', 0.10, { 
                    postType, 
                    platform,
                    businessType 
                });
                
                // Scroll to results
                document.getElementById('resultSection').scrollIntoView({ behavior: 'smooth' });
            }
            
            generatePromotionContent(business, offer, platform) {
                const templates = this.templates.promotion;
                const template = templates[Math.floor(Math.random() * templates.length)];
                
                return template
                    .replace(/{business}/g, business)
                    .replace(/{offer}/g, offer || 'special discounts')
                    .replace(/{industry}/g, this.getIndustryFromBusiness(business))
                    .replace(/{location}/g, 'your location')
                    .replace(/{action}/g, 'visit us today');
            }
            
            generateQuoteContent(business, platform) {
                const templates = this.templates.quote;
                const template = templates[Math.floor(Math.random() * templates.length)];
                
                return template
                    .replace(/{business}/g, business)
                    .replace(/{businessType}/g, this.getIndustryFromBusiness(business))
                    .replace(/{targetAudience}/g, 'our customers');
            }
            
            generateAnnouncementContent(business, announcement, platform) {
                const templates = this.templates.announcement;
                const template = templates[Math.floor(Math.random() * templates.length)];
                
                return template
                    .replace(/{business}/g, business)
                    .replace(/{announcement}/g, announcement || 'exciting new developments')
                    .replace(/{benefit1}/g, 'better service')
                    .replace(/{benefit2}/g, 'more options')
                    .replace(/{benefit3}/g, 'faster response times')
                    .replace(/{milestone}/g, '1000 customers served')
                    .replace(/{specialOffer}/g, 'a special thank you discount')
                    .replace(/{date}/g, 'next Monday')
                    .replace(/{location}/g, 'our location')
                    .replace(/{targetAudience}/g, 'business owners');
            }
            
            generateDefaultContent(business, message, platform) {
                return `🌟 Exciting News from ${business}! 🌟\n\n${message}\n\nWe're committed to providing the best ${this.getIndustryFromBusiness(business)} experience for our customers.\n\n📍 Visit us today\n⏰ Business hours: 9AM-5PM\n📞 Contact us for more details\n\n#smallbusiness #${this.getIndustryFromBusiness(business).replace(/\s+/g, '')}`;
            }
            
            getIndustryFromBusiness(business) {
                const industries = {
                    'coffee': 'coffee shop',
                    'restaurant': 'dining experience',
                    'fitness': 'fitness training',
                    'salon': 'beauty services',
                    'store': 'retail shopping',
                    'agency': 'marketing services'
                };
                
                const lowerBusiness = business.toLowerCase();
                for (const [key, value] of Object.entries(industries)) {
                    if (lowerBusiness.includes(key)) return value;
                }
                
                return 'business services';
            }
            
            checkUsageLimits() {
                if (this.usageData.premium) return true;
                
                if (this.usageData.uses >= this.maxFreeUses) {
                    this.showUpgradePrompt();
                    return false;
                }
                
                this.usageData.uses++;
                this.usageData.lastReset = new Date().toISOString().split('T')[0];
                localStorage.setItem(this.usageKey, JSON.stringify(this.usageData));
                this.updateUsageDisplay();
                return true;
            }
            
            showUpgradePrompt() {
                Swal.fire({
                    title: '✨ Daily Limit Reached!',
                    html: `You've used all ${this.maxFreeUses} free posts for today!<br><br>
                           <strong>Upgrade to Premium</strong> for unlimited posts, advanced templates, and scheduling features!`,
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: '<i class="fas fa-crown me-1"></i> Upgrade for $7/month',
                    cancelButtonText: '<i class="fas fa-times me-1"></i> Continue Free',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.showPremiumUpgrade('pro');
                    }
                });
            }
            
