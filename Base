            }
            
            startFreeTrial(plan) {
                Swal.fire({
                    title: '🎉 Free Trial Started!',
                    html: `
                        <p class="text-center mb-4">Your 7-day free trial of the ${this.capitalizeFirstLetter(plan)} plan has begun!</p>
