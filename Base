                });
                
                // Set premium status
                this.usageData.premium = true;
                localStorage.setItem(this.premiumKey, 'true');
                localStorage.setItem(this.usageKey, JSON.stringify(this.usageData));
                
                // Track revenue event (trial start = future revenue)
                this.trackRevenueEvent('premium_trial', 1.50, { plan, trialDays: 7 });
                
                // Refresh page to show premium features
                setTimeout(() => {
                    location.reload();
                }, 1500);
            }
            
            showTemplatePreview(template) {
                if (template.includes('premium') && !this.usageData.premium) {
                    Swal.fire({
                        title: '✨ Premium Template!',
                        html: `This template is available with our <strong>Premium Plan</strong>.<br><br>
                               Upgrade to unlock all 20+ professional templates and advanced features!`,
                        icon: 'star',
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-crown me-1"></i> Upgrade Now',
                        cancelButtonText: '<i class="fas fa-times me-1"></i> Show Free Templates',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            this.showPremiumUpgrade('pro');
                        }
                    });
                    return;
                }
                
                const previews = {
                    quote: 'Inspirational quote template with professional typography and brand alignment',
                    promo: 'Eye-catching promotion template with clear call-to-action and urgency elements',
                    analytics: 'Data-driven post template with statistics and engagement hooks',
                    testimonial: 'Customer testimonial template with social proof and credibility elements',
                    behind-scenes: 'Authentic behind-the-scenes template with team photos and story elements',
                    tips: 'Educational tips template with valuable insights and expertise positioning'
                };
                
                Swal.fire({
                    title: `<i class="fas fa-palette me-2"></i> ${this.capitalizeFirstLetter(template)} Template`,
                    html: `
                        <div class="text-center mb-3">
                            <div class="p-3 bg-light rounded mb-3">
                                <p class="mb-0 text-muted">Template Preview:</p>
                                <p class="fw-bold mb-0">"${previews[template] || 'Professional social media template'}"</p>
                            </div>
                        </div>
                        <p class="text-center text-muted small">
                            <i class="fas fa-info-circle me-1"></i> This template will be customized with your business details when you generate content
                        </p>
                    `,
                    icon: 'info',
                    confirmButtonText: '<i class="fas fa-magic me-1"></i> Use This Template'
                });
            }
            
            copyContent() {
                const content = document.getElementById('generatedContent').innerText;
                navigator.clipboard.writeText(content).then(() => {
                    Swal.fire({
                        icon: 'success',
                        title: '✅ Copied to Clipboard!',
                        text: 'Your AI-generated content is ready to paste into your social media platform.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    
                    this.trackRevenueEvent('content_copy', 0.05);
                });
            }
            
            saveContent() {
                const content = document.getElementById('generatedContent').innerText;
                const timestamp = new Date().toISOString().split('T')[0];
                
                let savedContent = localStorage.getItem('bp_saved_content');
                if (!savedContent) savedContent = [];
                else savedContent = JSON.parse(savedContent);
                
                savedContent.push({
                    content,
                    timestamp,
                    id: `content_${Date.now()}`
                });
                
                // Keep only last 10 saved items
                if (savedContent.length > 10) {
                    savedContent = savedContent.slice(-10);
                }
                
                localStorage.setItem('bp_saved_content', JSON.stringify(savedContent));
                
                Swal.fire({
                    icon: 'success',
                    title: '✅ Content Saved!',
                    text: 'Your content has been saved for later use. Access it from your saved items.',
                    timer: 2000,
                    showConfirmButton: false
                });
            }
            
            shareContent() {
                const content = document.getElementById('generatedContent').innerText;
                const shareText = `Check out this amazing AI-generated social media content from BusinessPostAI!\n\n${content}\n\n#BusinessPostAI #AISocialMedia #SmallBusinessMarketing`;
                
                if (navigator.share) {
                    navigator.share({
                        title: 'BusinessPostAI Content',
                        text: shareText,
                        url: window.location.href
                    }).then(() => {
                        this.trackRevenueEvent('content_share', 0.15);
                    });
                } else {
                    navigator.clipboard.writeText(shareText).then(() => {
                        Swal.fire({
                            icon: 'success',
                            title: '✅ Ready to Share!',
                            html: 'Content copied to clipboard! Paste it into your favorite social media platform or messaging app.',
                            timer: 3000,
                            showConfirmButton: false
                        });
                        this.trackRevenueEvent('content_share', 0.15);
                    });
                }
            }
            
            submitLeadForm() {
                const formData = new FormData(document.getElementById('marketingForm'));
                
                // Simulate form submission
                Swal.fire({
                    title: '🔄 Processing Your Request...',
                    html: 'Matching you with top marketing agencies...',
                    timer: 2000,
                    timerProgressBar: true,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                }).then(() => {
                    Swal.fire({
                        icon: 'success',
                        title: '✅ Match Request Submitted!',
                        html: `
                            <p class="text-center mb-4">Great! We've received your request and are matching you with vetted marketing agencies.</p>
                            <div class="text-center mb-3">
                                <i class="fas fa-envelope text-primary fs-1"></i>
                                <h4 class="mt-2">What happens next:</h4>
                            </div>
                            <ul class="list-unstyled text-start">
                                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> 3-5 agencies will contact you within 24-48 hours</li>
                                <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i> You'll receive customized proposals</li>
                                <li><i class="fas fa-check-circle text-success me-2"></i> Choose the best fit - no obligation</li>
                            </ul>
                            <p class="text-muted small mt-3">
                                <i class="fas fa-shield-alt me-1"></i> Your information is secure and only shared with trusted partners
                            </p>
                        `,
                        confirmButtonText: '<i class="fas fa-thumbs-up me-1"></i> Got It!'
                    });
                    
                    // Track high-value lead event
                    this.trackRevenueEvent('lead_submission', 10.00, { 
                        leadType: 'marketing_agency_match',
                        estimatedValue: '$10-100 per lead'
                    });
                    
                    // Reset form
                    document.getElementById('marketingForm').reset();
                });
            }
            
            trackRevenueEvent(eventType, value, metadata = {}) {
                const now = new Date();
                const today = now.toISOString().split('T')[0];
                
                // Update daily revenue
                if (!this.revenueData.daily[today]) {
                    this.revenueData.daily[today] = 0;
                }
                this.revenueData.daily[today] += value;
                this.revenueData.total += value;
                
                // Add event
                this.revenueData.events.push({
                    id: `event_${Date.now()}`,
                    type: eventType,
                    value: value,
                    timestamp: now.toISOString(),
                    metadata: metadata
                });
                
                // Keep only last 100 events
                if (this.revenueData.events.length > 100) {
                    this.revenueData.events = this.revenueData.events.slice(-100);
                }
                
                this.revenueData.lastUpdated = now.toISOString();
                localStorage.setItem(this.revenueKey, JSON.stringify(this.revenueData));
                
                console.log(`Revenue event tracked: ${eventType} - $${value.toFixed(2)}`);
                this.updateRevenueDisplay();
                
                // Show revenue tracker if hidden
                document.getElementById('revenueTracker').style.display = 'block';
            }
            
            updateUsageDisplay() {
                const remaining = this.maxFreeUses - this.usageData.uses;
                document.getElementById('usageCounter').innerHTML = `
                    <i class="fas fa-hourglass-half me-2"></i>
                    ${remaining} ${remaining === 1 ? 'post' : 'posts'} remaining today
                `;
            }
            
            updateRevenueDisplay() {
                const today = new Date().toISOString().split('T')[0];
                const dailyRevenue = this.revenueData.daily[today] || 0;
                
                document.getElementById('dailyRevenue').textContent = `$${dailyRevenue.toFixed(2)}`;
                document.getElementById('totalRevenue').textContent = `$${this.revenueData.total.toFixed(2)}`;
                
                // Update progress bar
                const progress = Math.min((dailyRevenue / 5) * 100, 100);
                document.querySelector('.progress-bar').style.width = `${progress}%`;
                
                // Update progress bar text
                const progressBar = document.querySelector('.progress-bar');
                progressBar.textContent = `${progress.toFixed(0)}%`;
                
                // Change color based on progress
                if (progress < 50) {
                    progressBar.className = 'progress-bar bg-warning';
                } else if (progress < 80) {
                    progressBar.className = 'progress-bar bg-primary';
                } else {
                    progressBar.className = 'progress-bar bg-success';
                }
            }
            
            showRevenueTracker() {
                // Show tracker if there's been any revenue today
                const today = new Date().toISOString().split('T')[0];
                if (this.revenueData.daily[today] && this.revenueData.daily[today] > 0) {
                    document.getElementById('revenueTracker').style.display = 'block';
                }
            }
            
            checkDailyReset() {
                const today = new Date().toISOString().split('T')[0];
                if (this.usageData.lastReset !== today) {
                    this.usageData.uses = 0;
                    this.usageData.lastReset = today;
                    localStorage.setItem(this.usageKey, JSON.stringify(this.usageData));
                    this.updateUsageDisplay();
                }
            }
            
            capitalizeFirstLetter(string) {
                return string.charAt(0).toUpperCase() + string.slice(1);
            }
        }
        
        // Initialize the app when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            const app = new BusinessPostAI();
            
            // Auto-scroll to section when nav links are clicked
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    const targetElement = document.querySelector(targetId);
                    
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 80,
                            behavior: 'smooth'
                        });
                    }
                });
            });
            
            // Show revenue tracker after 10 seconds if hidden
            setTimeout(() => {
                if (document.getElementById('revenueTracker').style.display === 'none') {
                    document.getElementById('revenueTracker').style.display = 'block';
                    
                    // Animate the appearance
                    const tracker = document.getElementById('revenueTracker');
                    tracker.style.opacity = '0';
                    tracker.style.transform = 'translateY(20px)';
                    
                    setTimeout(() => {
                        tracker.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                        tracker.style.opacity = '1';
                        tracker.style.transform = 'translateY(0)';
                    }, 100);
                }
            }, 10000);
        });
    </script>
